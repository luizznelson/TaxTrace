# Preparação privada do projeto Neon do TaxTrace. Não publicar ou enviar pelo chat.
# Este arquivo NÃO é carregado automaticamente pela aplicação.
# Preencha só TAXTRACE_NEON_ADMIN_URL. Host e banco serão derivados da URI direta.
TAXTRACE_NEON_HOST=
TAXTRACE_NEON_DATABASE=neondb
# URI administrativa do painel Neon. Usada apenas na preparação explícita futura,
# nunca como conexão de runtime ou como conexão de testes.
TAXTRACE_NEON_ADMIN_URL=
# Deixe vazias para geração local de senhas exclusivas pelo configurador.
# Nenhum papel ou tabela é criado apenas por preencher este arquivo.
TAXTRACE_NEON_READER_PASSWORD=
TAXTRACE_NEON_STATE_PASSWORD=
