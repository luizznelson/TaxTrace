# Desenvolvimento local; credenciais de exemplo, sem acesso externo.
TAXTRACE_DB_PASSWORD=taxtrace_dev_example
TAXTRACE_TEST_DB_PASSWORD=taxtrace_test_example
TAXTRACE_READER_PASSWORD=taxtrace_reader_example
DATABASE_URL=postgresql://taxtrace:taxtrace_dev_example@127.0.0.1:15433/taxtrace
TAXTRACE_TEST_DATABASE_URL=postgresql://taxtrace_test:taxtrace_test_example@127.0.0.1:15434/taxtrace_test
TAXTRACE_READER_DATABASE_URL=postgresql://taxtrace_reader:taxtrace_reader_example@127.0.0.1:15433/taxtrace
# Testes exigem também TAXTRACE_TEST_DATABASE=1. Não aponte este arquivo para o Neon.

# Opcional: planejador de consultas por IA. O modo local não usa chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: modelo de síntese RAG; vazio reutiliza GEMINI_MODEL.
GEMINI_RAG_MODEL=

# Checkpoints PostgreSQL opcionais (execução no Docker/Linux; padrão local: sqlite).
# Checkpoints e vínculos usam o mesmo backend. Não libera deploy público.
TAXTRACE_CHECKPOINT_BACKEND=sqlite
TAXTRACE_CHECKPOINT_PASSWORD=
TAXTRACE_CHECKPOINT_DATABASE_URL=postgresql://taxtrace_state:SUBSTITUA@127.0.0.1:15433/taxtrace

# Opcional: JSON da credencial com hash gerado localmente; nunca uma senha em texto puro.
# Prevalece sobre data/checkpoints/revisor.json se preenchido. Não publique o valor.
TAXTRACE_REVIEWER_CREDENTIAL_JSON=

# Runtime remoto opcional: configure host direto e banco exclusivos do TaxTrace.
# Ative TAXTRACE_DATABASE_MODE=neon somente após preparar o banco de destino.
# Não altere DATABASE_URL para remoto: manutenção continua restrita ao ambiente local.
TAXTRACE_NEON_HOST=
TAXTRACE_NEON_DATABASE=taxtrace

# Hospedagem: origem HTTPS exata, sem caminho/porta. Vazio mantém execução local.
# No Render, RENDER_EXTERNAL_HOSTNAME fornece a origem automaticamente.
TAXTRACE_PUBLIC_URL=
# Somente no modo público: habilite após configurar a chave e validar a hospedagem.
TAXTRACE_PUBLIC_AI_ENABLED=false
